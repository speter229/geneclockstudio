# Python
__pycache__/
*.pyc
.pytest_cache/

# Secrets / credentials - never commit these
backend/https_codes/*.key
backend/https_codes/*.csr
backend/https_codes/*.crt
backend/data/users.json
.secrets/

# Proprietary clock feature lists. Only the encrypted *.enc versions belong in git;
# the plaintext CSVs are produced locally by scripts/protect_clock_features.py
# --decrypt for maintenance and must never be committed again.
backend/data/hannum_elnet_cg_order.csv
backend/data/Hannum_Inflammation_elnet_nonzero_cpg_order.csv
backend/data/inflamm_hugging_models_cg_order.csv
backend/data/computage_elnet_nonzero_cpg_order.csv
backend/data/inflammation_cg_means.csv
backend/data/example_datasets/apply_demo_inflammatory_clocks_beta.csv

# Runtime / per-user generated data (differs per deployment, never sync via git)
backend/temp/*
!backend/temp/.gitkeep
backend/saved_models/*
!backend/saved_models/.gitkeep

# Large bundled example beta-value matrices (100s of MB - 2GB): exceed GitHub's
# 100MB per-file limit, so these are deployed via direct file copy (scp/rsync),
# never through git. The small matching metadata CSVs stay tracked normally.
backend/data/example_datasets/compute_age_training_subset_1_beta.csv
backend/data/example_datasets/compute_age_training_subset_2_beta.csv
backend/data/example_datasets/compute_age_training_subset_3_beta.csv

# Raw source drop for the above (unrenamed duplicates, same huge files) - not needed in git
/fix_datasets/

